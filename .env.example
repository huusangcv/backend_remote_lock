# Environment
NODE_ENV=development
PORT=5001

# MongoDB Connection
MONGODB_CONNECT_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/remote_lock?retryWrites=true&w=majority

# API Key for admin operations (generate a strong random string)
ADMIN_API_KEY=your-super-secret-api-key-change-this

# CORS - comma separated allowed origins
CORS_ORIGIN=*
